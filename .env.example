# Copy this file to .env and fill in your values. .env is git-ignored.

# --- Required: OpenRouter (LLM + embeddings) ---------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-haiku-5.5
# Judge for DeepEval — deliberately a different model family than LLM_MODEL
JUDGE_MODEL=openai/gpt-6-luna
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIM=1536

# --- Vector store: Qdrant ----------------------------------------------------
# Leave QDRANT_URL empty to run Qdrant in local (embedded) mode — no account needed.
# Set it to your Qdrant Cloud cluster URL to use the hosted free tier.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_LOCAL_PATH=.qdrant
QDRANT_COLLECTION=sungrid_kb

# --- Optional: TypeSafe Jev (query classifier) --------------------------------
# If TYPESAFE_API_KEY is empty, the classifier falls back to an LLM via OpenRouter.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
# auto = Jev if a key is present, else LLM. Force with "jev" or "llm".
CLASSIFIER_BACKEND=auto
# strict  = filter retrieval on the single primary category only (literal reading of the brief)
# widened = primary + any runner-up category with probability >= 0.10 (default; see README)
FILTER_MODE=widened
